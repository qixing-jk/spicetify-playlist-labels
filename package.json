{
  "name": "spicetify-playlist-labels",
  "version": "1.3.0",
  "private": true,
  "scripts": {
    "build": "spicetify-creator",
    "build-local": "spicetify-creator --out=dist --minify",
    "watch": "spicetify-creator --watch",
    "build:ci": "spicetify-creator --out=dist --minify",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "update-types": "curl -s -o src/types/spicetify.d.ts https://raw.githubusercontent.com/spicetify/cli/main/globals.d.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^18.2.36",
    "@types/react-dom": "^18.2.14",
    "prettier": "3.6.2",
    "spicetify-creator": "^1.0.16",
    "typescript": "^5.9.3"
  }
}
